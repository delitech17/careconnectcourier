# Example environment variables for CareConnectCourier server
# Copy to .env and update values before running in production

# Server
PORT=3000
NODE_ENV=development

# Application URL (used in email templates and redirects)
APP_URL=http://localhost:3000

# Admin token (must set to a strong value in production)
ADMIN_TOKEN=change-this-to-a-strong-token

# JWT secret for user tokens
JWT_SECRET=change-this-to-a-secure-secret

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=200

# Email credentials (use real credentials in production)
EMAIL_USER=you@example.com
EMAIL_PASS=your-email-password
