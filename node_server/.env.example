# Example environment variables for CareConnectCourier server
# Copy to .env and update values before running in production

# Server
PORT=3000
NODE_ENV=development

# Admin token (must set to a strong value in production)
ADMIN_TOKEN=change-this-to-a-strong-token

# JWT secret for user tokens
JWT_SECRET=change-this-to-a-secure-secret

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=200

# Email credentials (use real credentials in production)
EMAIL_USER=you@example.com
EMAIL_PASS=your-email-password
# Environment variables for CareConnect Courier backend

# Server Port
PORT=3000

# Admin Authentication Token
ADMIN_TOKEN=demo-token-12345

# JWT Secret for user authentication
JWT_SECRET=jwt-secret-key-12345

# Email Configuration (for movement notifications and chat replies)
# Using Gmail - you'll need to generate an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional: Stripe API Key for payment processing
# STRIPE_SECRET_KEY=sk_test_your_key_here
